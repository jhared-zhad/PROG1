int d;
printf("Enter a number (1-7): ");
scanf("%d", &d);

switch (d) {
    case 1: printf("Day %d is Monday\n", d);    break;
    case 2: printf("Day %d is Tuesday\n", d);   break;
    case 3: printf("Day %d is Wednesday\n", d); break;
    case 4: printf("Day %d is Thursday\n", d);  break;
    case 5: printf("Day %d is Friday\n", d);    break;
    case 6: printf("Day %d is Saturday\n", d);  break;
    case 7: printf("Day %d is Sunday\n", d);    break;
    default: printf("Error: Please enter a number from 1 to 7.\n");
}
