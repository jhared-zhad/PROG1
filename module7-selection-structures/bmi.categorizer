double weight, height, bmi;
printf("Enter weight (kg): ");
scanf("%lf", &weight);
printf("Enter height (m): ");
scanf("%lf", &height);

bmi = weight / (height * height);

printf("BMI: %.2f\n", bmi);
if (bmi < 18.5)      printf("Category: Underweight\n");
else if (bmi < 25.0) printf("Category: Normal\n");
else if (bmi < 30.0) printf("Category: Overweight\n");
else                 printf("Category: Obese\n");

//This is with the function//

#include <stdio.h>

void checkBMI(double weight, double height) {
    double bmi = weight / (height * height);

    printf("BMI: %.2f\n", bmi);
    if (bmi < 18.5)      printf("Category: Underweight\n");
    else if (bmi < 25.0) printf("Category: Normal\n");
    else if (bmi < 30.0) printf("Category: Overweight\n");
    else                 printf("Category: Obese\n");
}

int main() {
    double weight, height;
    printf("Enter weight (kg): ");
    scanf("%lf", &weight);
    printf("Enter height (m): ");
    scanf("%lf", &height);
    checkBMI(weight, height);
    return 0;
}
