//This is with the function//

#include <stdio.h>

void checkEvenOdd(int n);   // Prototype (declaration)

int main() {
    int n;
    printf("Enter a number: ");
    scanf("%d", &n);
    checkEvenOdd(n);
    return 0;
}

void checkEvenOdd(int n) {  // Definition
    if (n % 2 == 0) {
        printf("%d is EVEN.\n", n);
    } else {
        printf("%d is ODD.\n", n);
    }
}
